.env
__pycache__/
*.pyc
*.pyd

# Virtual environments. `Scripts\` rather than `bin/` is the Windows layout;
# both spellings of the usual directory names are listed because `py -m venv`
# does not impose one.
.venv/
venv/
env/

# Windows shell and Explorer droppings.
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linter/type-checker caches. Untracked upstream via a global excludes file,
# which a fresh clone or a fresh `git init` does not inherit.
.mypy_cache/
.ruff_cache/
# Claude Code editor config — not part of the app. This project uses the
# anthropic Client SDK directly (core/claude.py), NOT the Claude Agent SDK,
# so nothing here is needed to run or use the project.
.claude/

# The `memory` tool's store (core/memory.py, CLAUDE_MEMORY_DIR). Claude's own
# notes to itself across sessions — local state, not source.
memories/

# A `command = ["node", ...]` MCP server entry in config.toml may point at a
# checkout that lives here. Nothing in this project installs it.
node_modules/
